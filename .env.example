# --- LLM (system under test as red-teamer / judge; optional) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_TIMEOUT_S=60
ANTHROPIC_MAX_RETRIES=3

# --- Target system under test ---
TARGET_SYSTEM_URL=http://localhost:8001
TARGET_ADAPTER=chat
TARGET_API_KEY=
TARGET_TIMEOUT_S=30
TARGET_MAX_RETRIES=3
MAX_CONCURRENCY=8

# --- Guardrails ---
ENABLE_GUARDRAILS=true
GUARDRAILS_MODE=regex

# --- API security ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
RATE_LIMIT=30/minute
LOG_LEVEL=INFO

# --- Persistence (SQLite by default; set DATABASE_URL for Postgres) ---
DATABASE_URL=
SQLITE_PATH=data/runs.sqlite3

# --- Observability (LangSmith; optional) ---
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=ai-safety-redteam
